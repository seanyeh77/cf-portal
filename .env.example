# Copy to .env and fill in the required values. See README.md for details.

# --- required ---
# Cloudflare API token limited to this zone: Zone.DNS:Edit, Zone.Zone:Read
# (optional) Account.Cloudflare Tunnel:Read shows tunnel names and states
CF_API_TOKEN=
# Output of: docker compose run --rm portal hashpw
ADMIN_PASSWORD_HASH=
# At least 32 characters, e.g. openssl rand -base64 48
SECRET_KEY=

# --- docker compose port mapping ---
# Host port the portal is published on (the container always listens on 8080).
PORTAL_PORT=8080
# Host address to bind; 127.0.0.1 keeps it reachable only from a local reverse proxy.
PORTAL_BIND=0.0.0.0

# --- Cloudflare ---
CF_ZONE_NAME=example.org
# CF_ZONE_ID=
# Account owning the zone, for the Cloudflare Tunnel list; looked up from the zone when empty.
# CF_ACCOUNT_ID=
# CF_API_BASE=https://api.cloudflare.com/client/v4

# --- login ---
ADMIN_USERNAME=admin
SESSION_HOURS=12
# Set to false only when the site is served over plain HTTP.
COOKIE_SECURE=true

# --- access control (source IP) ---
ALLOWED_CIDRS=127.0.0.0/8,::1/128,10.0.0.0/8,192.168.0.0/16,fc00::/7
ADMIN_ALLOWED_CIDRS=127.0.0.0/8,::1/128,10.0.0.0/8,192.168.0.0/16,fc00::/7
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto are trusted.
TRUSTED_PROXIES=127.0.0.1

# --- storage ---
DB_PATH=/data/portal.db
PORTAL_TITLE=Service Portal
TIMEZONE=Asia/Taipei

# --- service status checks ---
CHECK_INTERVAL=60
CHECK_TIMEOUT=8
# false when services use self-signed certificates
CHECK_VERIFY_TLS=true
SIMPLE_ICONS_BASE=https://cdn.jsdelivr.net/npm/simple-icons@latest/icons

# --- record scan and maintenance ---
RECORD_SCAN_INTERVAL=21600
SCAN_TIMEOUT=2.5
SCAN_DNS_CANARY=cloudflare.com
MAINT_INTERVAL=3600
SNAPSHOT_KEEP=30
